# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
# For local dev these are printed by `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS — used by webhook handlers and cron jobs only.
# If this ever appears in client code, that is a security incident.
SUPABASE_SERVICE_ROLE_KEY=""

# --- App ---
# Absolute origin, used to build shareable event links and payment callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Razorpay (Phase 3) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From the Razorpay dashboard webhook settings. Used to verify webhook signatures.
RAZORPAY_WEBHOOK_SECRET=""

# --- Auth hook ---
# Supabase Auth signs the send_sms hook with this. Must match
# [auth.hook.send_sms].secrets in supabase/config.toml.
# Generate with: node -e "console.log('v1,whsec_'+require('crypto').randomBytes(24).toString('base64'))"
SEND_SMS_HOOK_SECRET=""

# --- WhatsApp (Phase 4) ---
# The WABA must be registered with India as Sold-To country and INR billing,
# otherwise authentication templates bill at the international rate
# (~Rs 2.30 vs ~Rs 0.115 per message). This cannot be changed after creation.
WHATSAPP_PROVIDER="log"
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Notifications (Phase 4) ---
# Bookings created before this instant are invisible to the notification
# sweep. Set it once, to the moment Phase 4 goes live. Moving it backwards
# will message people about events they booked long ago.
#
# SET IT. The schema keeps a default so the app boots in dev, and that default
# is the danger: unlike CRON_SECRET, forgetting this fails OPEN and silently.
# Go live a month after the date below and the first tick treats every booking
# made in the interim as owing a confirmation, and sends one.
NOTIFICATIONS_LAUNCH_AT="2026-08-12T00:00:00Z"

# Vercel Cron presents this as `Authorization: Bearer <secret>`. Any request
# without it is refused, so an unset value means the route is closed.
# Set it in Vercel Production LAST, only once WHATSAPP_PROVIDER=meta is live:
# a tick that runs while the provider is still "log" marks real messages sent
# without sending them, and dedupe_key never offers them again.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# --- Ticket signing (Phase 2) ---
# Root secret for deriving per-event HMAC keys used to sign QR payloads.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SIGNING_SECRET=""

# Play Store TWA (docs/runbooks/play-store-twa.md). Leave unset until the
# signing key exists; assetlinks.json 404s while either is missing.
TWA_PACKAGE_NAME=
TWA_CERT_SHA256=
